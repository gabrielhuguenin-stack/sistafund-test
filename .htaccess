# SISTAFUND — Apache configuration for the OVH hosting.
#
# It does four things: forces HTTPS and the canonical (non-www) domain; keeps every old
# WordPress address alive with a 301 to its new page (so the Google ranking and the links
# already circulating are preserved); serves the site with clean URLs (no ".html" in the
# address bar); and sets the caching Vercel used to do on its own.
#
# NOTE FOR THE MIGRATION: the clean-URL and redirect rules run only on Apache (the OVH server),
# not on a local preview. Please validate them once live and adjust if the hosting setup needs it.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- HTTPS only ----
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---- the bare domain is canonical (drop www) ----
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ---- old WordPress addresses → the new pages (in their clean form) ----
  # renamed pages
  RewriteRule ^limited_partners(/.*)?$    /community [R=301,L]
  RewriteRule ^helpies(/.*)?$             /community [R=301,L]
  RewriteRule ^cat_helpies(/.*)?$         /community [R=301,L]
  RewriteRule ^mentions-legales/?$        /legal [R=301,L]
  RewriteRule ^esg-policy/?$              /esg [R=301,L]
  # a company opened its own page on WordPress; here it lives inside /portfolio
  RewriteRule ^portfolio/.+$              /portfolio [R=301,L]
  RewriteRule ^cat_portfolio(/.*)?$       /portfolio [R=301,L]
  RewriteRule ^location(/.*)?$            /portfolio [R=301,L]
  RewriteRule ^portfolio_status(/.*)?$    /portfolio [R=301,L]
  # an article now links straight out to its source, from /news
  RewriteRule ^news/.+$                   /news [R=301,L]
  RewriteRule ^cat_news(/.*)?$            /news [R=301,L]
  RewriteRule ^feed(/.*)?$                /news [R=301,L]
  # pages whose content now lives in a section of the home
  RewriteRule ^about/?$                   /#about [R=301,L]
  RewriteRule ^faq/?$                     /#faq [R=301,L]
  # WordPress leftovers with nothing behind them
  RewriteRule ^archives/?$                / [R=301,L]
  RewriteRule ^pied-de-page/?$            / [R=301,L]
  RewriteRule ^sistafund-tennis-balls/?$  / [R=301,L]
  # the four regulatory PDFs, now in /docs
  RewriteRule ^wp-content/uploads/.*responsible-investment-policy.*\.pdf$  /docs/responsible-investment-policy.pdf [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*declarationsfdr-article10\.pdf$        /docs/sfdr-article-10.pdf [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*pai-statement-sunshine\.pdf$           /docs/pai-statement.pdf [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*rapportlec29-sunshine\.pdf$            /docs/reporting-lec-29.pdf [R=301,L,NC]

  # ---- clean URLs: no ".html" in the address ----
  # the home page is only ever reached at "/"
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  # any explicit ".html" is sent to its clean form
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # a trailing slash is dropped (real directories excepted)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ /$1 [R=301,L]
  # serve the .html file that backs the clean URL (internal, no redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

DirectoryIndex index.html

# ---- Caching ----
# Assets are called with a ?v= that is bumped by hand when they change, so they may be cached
# hard and for a long time. The HTML must NOT be cached: it is what carries the new ?v=.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# data.js is the CONTENT (companies, team, news, community): edited far more often than the
# code, it must go live the moment it changes, so it is never cached — like the HTML. This is
# what lets an editor add a company or a news item by editing data.js alone, with no ?v= to bump.
<FilesMatch "^data\.js$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
