<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS only
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # non-www canonical
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # legacy URLs -> new pages
  RewriteRule ^limited_partners(/.*)?$    /community [R=301,L]
  RewriteRule ^helpies(/.*)?$             /community [R=301,L]
  RewriteRule ^cat_helpies(/.*)?$         /community [R=301,L]
  RewriteRule ^portfolio/.+$              /portfolio [R=301,L]
  RewriteRule ^cat_portfolio(/.*)?$       /portfolio [R=301,L]
  RewriteRule ^location(/.*)?$            /portfolio [R=301,L]
  RewriteRule ^portfolio_status(/.*)?$    /portfolio [R=301,L]
  RewriteRule ^news/.+$                   /news [R=301,L]
  RewriteRule ^cat_news(/.*)?$            /news [R=301,L]
  RewriteRule ^feed(/.*)?$                /news [R=301,L]
  RewriteRule ^about/?$                   /#about [R=301,L]
  RewriteRule ^faq/?$                     /#faq [R=301,L]
  RewriteRule ^archives/?$                / [R=301,L]
  RewriteRule ^pied-de-page/?$            / [R=301,L]
  RewriteRule ^sistafund-tennis-balls/?$  / [R=301,L]
  RewriteRule ^wp-content/uploads/.*responsible-investment-policy.*\.pdf$  /docs/responsible-investment-policy.pdf [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*declarationsfdr-article10\.pdf$        /docs/sfdr-article-10.pdf [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*pai-statement-sunshine\.pdf$           /docs/pai-statement.pdf [R=301,L,NC]
  RewriteRule ^wp-content/uploads/.*rapportlec29-sunshine\.pdf$            /docs/reporting-lec-29.pdf [R=301,L,NC]

  # clean URLs (no .html)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ /$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

DirectoryIndex index.html

# caching: assets 1 year (busted by ?v=), HTML and data.js never cached
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<FilesMatch "^data\.js$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
